# Copy to SettleBack/.env for local development. Never put secrets in this example file.

# local | testnet | mixed | mainnet
SETTLEBACK_ENV=local

SETTLEBACK_HOST=127.0.0.1
SETTLEBACK_PORT=8787

# fatal | error | warn | info | debug | trace | silent
SETTLEBACK_LOG_LEVEL=info

# disabled | enabled. Live environments refuse "enabled" until their chain, token,
# gateway, and finality configuration is implemented and present.
SETTLEBACK_PAYMENT_WRITES=disabled
