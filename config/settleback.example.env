# Copy to SettleBack/.env for local development. Never put secrets in this example file.

# local | testnet | mixed | mainnet
SETTLEBACK_ENV=local

SETTLEBACK_HOST=127.0.0.1
SETTLEBACK_PORT=8787

# fatal | error | warn | info | debug | trace | silent
SETTLEBACK_LOG_LEVEL=info

# disabled | enabled. Live environments refuse "enabled" until their chain, token,
# gateway, and finality configuration is implemented and present.
SETTLEBACK_PAYMENT_WRITES=disabled

# Optional. Defaults to SettleBack/data/settleback-<environment>.db (ignored by git).
# SETTLEBACK_DB_PATH=

# Local only: which live profile the simulation imitates (testnet | mixed | mainnet). Default testnet.
# SETTLEBACK_SIM_PROFILE=testnet

# Assessment of ambiguous cases. Without a key, an assessment request is recorded as failed
# (PROVIDER_NOT_CONFIGURED); it is never skipped. Put the key in .env, never in this file.
# ANTHROPIC_API_KEY=
# claude-opus-5-5 | claude-sonnet-5-5. Default claude-opus-5-5.
# SETTLEBACK_ASSESSMENT_MODEL=claude-opus-5-5
# low | medium | high. Default medium.
# SETTLEBACK_ASSESSMENT_EFFORT=medium
# Output limit per assessment, reasoning included (1000-32000). Default 8000.
# SETTLEBACK_ASSESSMENT_MAX_TOKENS=8000
# Per-request deadline in milliseconds (5000-120000). Default 45000.
# SETTLEBACK_ASSESSMENT_TIMEOUT_MS=45000
