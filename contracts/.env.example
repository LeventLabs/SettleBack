# Copy to contracts/.env (ignored by git) to deploy with a raw key instead of a Foundry keystore:
#   cp contracts/.env.example contracts/.env
# Only the deployment scripts read this file; the server never loads it.

# The account that pays for deployments. It has no authority over either contract.
DEPLOYER_ADDRESS=
# 0x followed by 64 hex digits, belonging to DEPLOYER_ADDRESS. Leave empty to sign with
# --account <keystore> --sender <address> instead (see contracts/README.md).
DEPLOYER_PRIVATE_KEY=

# Given per command rather than kept here (see contracts/README.md):
# SETTLEBACK_VERIFIER=  the registry's verifier address, fixed for its lifetime; must differ from the deployer
# REGISTRY_ADDRESS=     the registry on 133 that the mainnet marker points to
# COMMIT_SHA=           the 40-character commit the marker records
# REGISTRY_RPC_URL=     the 133 RPC the marker script checks the registry against (default https://testnet.hsk.xyz)
