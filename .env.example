# Copy to .env (ignored by git): cp .env.example .env
# Nothing here is required for `npm run demo`; every value below has a safe local default.
# Never put secrets in this example file.

# local | testnet | mixed | mainnet
SETTLEBACK_ENV=local

SETTLEBACK_HOST=127.0.0.1
SETTLEBACK_PORT=8787

# fatal | error | warn | info | debug | trace | silent
SETTLEBACK_LOG_LEVEL=info

# disabled | enabled. Live environments refuse "enabled" outside SETTLEBACK_DEMO=hsp-testnet, until
# their chain, token, gateway, and finality configuration is implemented and present.
SETTLEBACK_PAYMENT_WRITES=disabled

# Optional. Defaults to SettleBack/data/settleback-<environment>.db (ignored by git).
# SETTLEBACK_DB_PATH=

# Local only: which live profile the simulation imitates (testnet | mixed | mainnet). Default testnet.
# SETTLEBACK_SIM_PROFILE=testnet

# The browser origin users sign in from and the only origin writes are accepted from (a bare origin,
# no path). Required outside local, where it must be HTTPS. Default locally http://localhost:5173.
# SETTLEBACK_WEB_ORIGIN=http://localhost:5173
# Comma-separated wallet addresses that sign in as operators. No request can grant the role.
# SETTLEBACK_OPERATORS=

# Normally set by the demo launcher. fixtures (local only, `npm run demo`): seeds the fixture cases in
# memory for these two accounts. hsp-testnet (testnet only, `npm run demo:hsp`): jobs bought in the
# workspace and their repayments pay through HSP Agentic Payment on HSK Chain testnet.
# SETTLEBACK_DEMO=fixtures
# SETTLEBACK_DEMO_BUYER=
# SETTLEBACK_DEMO_SELLER=

# HSP Agentic Payment, for `npm run demo:hsp` (and `npm run hsp:check`). HSP's QA endpoint accepts only
# allowlisted addresses: run from one, or set the URL of a relay that runs on one. A relay token is read
# from ~/.config/settleback/hsp-relay.token (or the file named here), never from this file.
# SETTLEBACK_HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
# SETTLEBACK_HSP_RELAY_TOKEN_FILE=~/.config/settleback/hsp-relay.token
# The team's reporting name at HSP, used unchanged at order creation and in every query. Default SettleBack.
# SETTLEBACK_HSP_MERCHANT_NAME=SettleBack

# Read by the demo launcher itself (npm run demo / npm run demo:testnet), never passed to the server.
# Local anvil port for `npm run demo`. Default 8545.
# SETTLEBACK_DEMO_RPC_PORT=8545
# `npm run demo:testnet`: the HSK Chain testnet RPC, the demo registry, and the directory holding the
# verifier, buyer, seller, and operator key files (one 0x-prefixed key per file, readable only by you;
# `npm run demo:keys` creates them). The default registry is SettleBack's own demo registry, whose
# verifier key you do not have: deploy your own (see README) and set its address here.
# SETTLEBACK_DEMO_RPC_URL=https://testnet.hsk.xyz
# SETTLEBACK_DEMO_REGISTRY_ADDRESS=
# SETTLEBACK_DEMO_KEYS=~/.config/settleback/testnet-demo

# Assessment of ambiguous cases. Without a key, an assessment request is recorded as failed
# (PROVIDER_NOT_CONFIGURED); it is never skipped. Put the key in .env, never in this file.
# ANTHROPIC_API_KEY=
# claude-opus-5-5 | claude-sonnet-5-5. Default claude-opus-5-5.
# SETTLEBACK_ASSESSMENT_MODEL=claude-opus-5-5
# low | medium | high. Default medium.
# SETTLEBACK_ASSESSMENT_EFFORT=medium
# Output limit per assessment, reasoning included (1000-32000). Default 8000.
# SETTLEBACK_ASSESSMENT_MAX_TOKENS=8000
# Per-request deadline in milliseconds (5000-120000). Default 45000.
# SETTLEBACK_ASSESSMENT_TIMEOUT_MS=45000

# Recovery registry. Leave all three unset to run without it; integrated repayment is then unavailable.
# Locally, use a disposable chain (for example anvil); HSK Chain 133 and 177 are refused there,
# except for the demo's own registry on 133 that `npm run demo:testnet` configures.
# A live environment must use its profile's registry chain over HTTPS.
# SETTLEBACK_REGISTRY_RPC_URL=http://127.0.0.1:8545
# SETTLEBACK_REGISTRY_CHAIN_ID=31337
# SETTLEBACK_REGISTRY_ADDRESS=
# Blocks before a write or a reported reservation counts as confirmed. Default 1 locally, 3 live.
# SETTLEBACK_REGISTRY_CONFIRMATIONS=
# The registry verifier's key for registry writes (0x + 64 hex). Without it the server only reads and confirms.
# SETTLEBACK_VERIFIER_PRIVATE_KEY=
