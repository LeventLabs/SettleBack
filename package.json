{
  "name": "settleback",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run typecheck && npm run build --workspaces --if-present && npm run contracts:build",
    "dev:server": "npm run dev -w @settleback/server",
    "dev:web": "npm run dev -w @settleback/web",
    "contracts:build": "forge build --root contracts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
